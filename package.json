{
  "name": "buzzagent",
  "version": "0.1.17",
  "description": "Open-source visual workbench for AI coding agents — an opencode core with a GUI, and zero telemetry.",
  "productName": "BuzzAgent",
  "author": "BuzzAgent <hello@buzzagent.dev>",
  "homepage": "https://github.com/buzzband/buzzagent",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --bundles deb",
    "dist": "npm run setup:core && tauri build",
    "dist:debug": "npm run setup:core && tauri build --debug",
    "web": "vite",
    "preview": "vite preview",
    "setup:core": "./scripts/setup-core.sh src-tauri/bin",
    "test": "vitest run --exclude 'src/tests/integration.test.ts'",
    "test:integration": "vitest run src/tests/integration.test.ts",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.11",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.44.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
